       527E                     ERROR_NOT_READY:
00127E 527E F1              10      POP AF
00127F 527F 37               4      SCF
001280 5280 3E02             7      LD  A,2     ;Not ready
001282 5282 C9              10      RET
       5283                     DISKIO:
001283 5283 F5              11      PUSH    AF          ;A/CFを一旦退避(GET_DISK_BANK等でCFが壊れる為)
001284 5284 3E00             7      LD  A,0
001286 5286 17               4      RLA             ;bit0=書き込み要求か(旧CF)
001287 5287 32C6F2          13      LD  (DISK_WFLG),A
00128A 528A F1              10      POP AF
00128B 528B 48               4      LD  C,B
00128C 528C CDC654          17      CALL    GET_DISK_BANK
00128F 528F F5              11      PUSH    AF
001290 5290 3ACBF2          13      LD  A,(SECSZ_H)
001293 5293 B7               4      OR  A
001294 5294 28E8            12      JR  Z,ERROR_NOT_READY
001296 5296 F1              10      POP AF
001297 5297 F5              11      PUSH    AF
001298 5298 3AC6F2          13      LD  A,(DISK_WFLG)
00129B 529B B7               4      OR  A
00129C 529C 2032            12      JR  NZ,DISKIO_W
00129E 529E F1              10      POP AF
       529F                     SETMAP1:
00129F 529F E5              11      PUSH    HL
       52A0                     DISKIO1:
0012A0 52A0 C5              11      PUSH    BC      ;B=残りのセクタ数
0012A1 52A1 D5              11      PUSH    DE      ;DE=セクタ番号
0012A2 52A2 F5              11      PUSH    AF      ;A=8KB単位でカートリッジ内のディスクが存在する位置を指定
                                
0012A3 52A3 EB               4      EX  DE,HL       ;DE=受け取る読み出し先のメモリアドレス HL=セクタ番号
0012A4 52A4 F5              11      PUSH    AF
0012A5 52A5 3ACBF2          13      LD  A,(SECSZ_H)
0012A8 52A8 CDE954          17      CALL    MUL_AHL
0012AB 52AB F1              10      POP AF
                                #if exists USE_NORMAL32K_OR_ASCII16
                                    LD  A,L
                                    PUSH    BC
                                    LD  BC,-00020H  ;先頭の8KB部分
                                    ADD HL,BC
                                    POP BC
                                    JR  NC,DISKIO2
                                    LD  C,L     ;C=読み出し元
                                    ADD HL,HL   ;64KB→32KB
                                    ADD HL,HL   ;32KB→16KB バンク切り替えのサイズに合わせる
                                    CALL    GET_DISK_BANK_FDRV
                                    ADD A,H
                                    LD  (ASCII16_BANK1_SEL),A   ;ASCII-16K
                                    LD  (_BANK),A
                                    LD  L,C     ;C=読み出し元
                                    LD  A,03FH      ;セグメントのサイズでフィルタする(16K:3F)
                                    AND L
                                    ADD A,020H
                                #else
0012AC 52AC 4D               4      LD  C,L     ;C=読み出し元
0012AD 52AD 29              11      ADD HL,HL       ;64KB→32KB
0012AE 52AE 29              11      ADD HL,HL       ;32KB→16KB
0012AF 52AF 29              11      ADD HL,HL       ;16KB→8KB  バンク切り替えのサイズに合わせる
0012B0 52B0 84               4      ADD A,H
0012B1 52B1 320068          13      LD  (BANK1_SEL),A           ;ASCII-8K
0012B4 52B4 32C4F2          13      LD  (_BANK),A
0012B7 52B7 79               4      LD  A,C     ;C=読み出し元
0012B8 52B8 E61F             7      AND 01FH        ;セグメントのサイズでフィルタする(8K:1F)
                                #endif
       52BA                     DISKIO2:
0012BA 52BA C660             7      ADD A,high BANK1_ADR
0012BC 52BC 67               4      LD  H,A
0012BD 52BD ED4BCAF2        20      LD  BC,(SECSZ)  ;BCは読み出すセクタサイズ
0012C1 52C1 69               4      LD  L,C     ;C=0
0012C2 52C2 CDC344          17      CALL    ROM_LDIR
0012C5 52C5 EB               4      EX  DE,HL
0012C6 52C6 F1              10      POP AF
0012C7 52C7 D1              10      POP DE
0012C8 52C8 13               6      INC DE
0012C9 52C9 C1              10      POP BC
0012CA 52CA 10D4            13      DJNZ    DISKIO1
0012CC 52CC 41               4      LD  B,C
                                
0012CD 52CD E1              10      POP HL
0012CE 52CE AF               4      XOR A
0012CF 52CF C9              10      RET
                                
                                ;
                                ;   似非RAMディスクへの書き込み要求
                                ;   A=GET_DISK_BANKの結果(書き込み先ディスクの起点バンク)
                                ;   B=セクタ数 DE=セクタ番号 HL=転送元メモリアドレス(スタックにAF退避済み)
                                ;
       52D0                     DISKIO_W:
0012D0 52D0 F1              10      POP AF          ;GET_DISK_BANKの結果(起点バンク)を回収
0012D1 52D1 F5              11      PUSH    AF          ;DISK_WRITE_RAMに渡す為に保持しておく
0012D2 52D2 3E01             7      LD  A,1         ;書き込みルーチンの常駐セグメント#1を
0012D4 52D4 320068          13      LD  (BANK1_SEL),A       ;BANK1(6000h-7fffh)へマッピングする
0012D7 52D7 F1              10      POP AF
0012D8 52D8 C30660          10      JP  DISK_WRITE_RAM      ;戻り値の設定とRETはDISK_WRITE_RAM側で行う
                                
