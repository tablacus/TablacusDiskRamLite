001BBA F287 CA71FE          10      JP  Z,H_BINS
001BBD F28A FE8A             7      CP  08AH            ;RUN
001BBF F28C CA76FE          10      JP  Z,H_BINL
001BC2 F28F FED6             7      CP  0D6H            ;COPY
001BC4 F291 2813            12      JR  Z,FIX_COPY
001BC6 F293 FECF             7      CP  0CFH            ;BLOAD
001BC8 F295 C0              11      RET NZ
