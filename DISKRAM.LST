001C10 F2FD 0000                    DW  0
       F2FF                     _SP:
001C12 F2FF 0000                    DW  0
       F300                     _SP_H   EQU $-1
       F301                     FDRV:
001C14 F301 00                      DB  0
       F302                     FNAME:
001C15 F302                         DS  8+3
       F30D                     IS_BIOS:            ;C-BIOSの場合は0
