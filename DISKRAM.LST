000EF1 4EF1 32C4F2          13      LD  (_BANK),A
000EF4 4EF4 69               4      LD  L,C     ;C=読み出し元
000EF5 4EF5 3E1F             7      LD  A,01FH          ;セグメントのサイズでフィルタする(8K:1F)
000EF7 4EF7 A5               4      AND L
                                #endif
