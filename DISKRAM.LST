       F2C3                     _RESULT:
001BF6 F2C3 00                      DB  0
       F2C4                     _BANK:
001BF7 F2C4 00                      DB  0
       F2C5                     _BANK1:
001BF8 F2C5 00                      DB  0
       F2C6                     DISK_WFLG:              ;DISKIO呼び出し時の書き込み要求フラグ(0=読み出し/非0=書き込み)
001BF9 F2C6 00                      DB  0
       F2C7                     S1B_DRV:                ;_SYS1B処理中の対象ドライブ番号(0オリジン)退避用
001BFA F2C7 00                      DB  0
       F2C8                     CLSZ:               ;クラスタサイズ
001BFB F2C8 0004                    DW  1024
       F2C9                     CLSZ_H  EQU $-1     ;クラスタサイズ上位8ビット
