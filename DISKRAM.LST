       52BE                     DISKIO1:
0012BE 52BE C5              11      PUSH    BC      ;B=残りのセクタ数
0012BF 52BF D5              11      PUSH    DE      ;DE=セクタ番号
0012C0 52C0 F5              11      PUSH    AF      ;A=8KB単位でカートリッジ内のディスクが存在する位置を指定
                                
0012C1 52C1 EB               4      EX  DE,HL       ;DE=受け取る読み出し先のメモリアドレス HL=セクタ番号
0012C2 52C2 F5              11      PUSH    AF
0012C3 52C3 3ACAF2          13      LD  A,(SECSZ_H)
0012C6 52C6 CD1055          17      CALL    MUL_AHL
0012C9 52C9 F1              10      POP AF
                                #if exists USE_NORMAL32K_OR_ASCII16
                                    LD  A,L
                                    PUSH    BC
                                    LD  BC,-00020H  ;先頭の8KB部分
                                    ADD HL,BC
                                    POP BC
                                    JR  NC,DISKIO2
                                    LD  C,L     ;C=読み出し元
                                    ADD HL,HL   ;64KB→32KB
                                    ADD HL,HL   ;32KB→16KB バンク切り替えのサイズに合わせる
                                    CALL    GET_DISK_BANK_FDRV
                                    ADD A,H
                                    LD  (ASCII16_BANK1_SEL),A   ;ASCII-16K
                                    LD  (_BANK),A
                                    LD  L,C     ;C=読み出し元
                                    LD  A,03FH      ;セグメントのサイズでフィルタする(16K:3F)
                                    AND L
                                    ADD A,020H
                                #else
0012CA 52CA 4D               4      LD  C,L     ;C=読み出し元
0012CB 52CB 29              11      ADD HL,HL       ;64KB→32KB
0012CC 52CC 29              11      ADD HL,HL       ;32KB→16KB
0012CD 52CD 29              11      ADD HL,HL       ;16KB→8KB  バンク切り替えのサイズに合わせる
