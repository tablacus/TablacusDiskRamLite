                                ;
                                ;   空きクラスタ数を数える
                                ;   IN  A =対象ドライブ番号(0オリジン、0=A: 1=B:)
                                ;       DE=MAXCLUS(最後に調べるクラスタ番号、GETDPBの計算結果そのまま)
                                ;   OUT HL=空きクラスタ数
                                ;
                                ;   クラスタ番号は標準的なFAT12の2オリジン(有効なクラスタ番号は
                                ;   2〜MAXCLUS)。GNCL/NCL3もこの前提で作られている為、2未満の
                                ;   クラスタは調べない。
                                ;
                                ;   FDRVの退避・復帰はこのルーチン内で完結する
                                ;   (GNCL/NCL3内部でGET_DISK_BANK_FDRVを使ってFATのバンクを選ぶ為、
                                ;   呼び出し中だけFDRVを対象ドライブに切り替える)
                                ;
       4EB1                     DSKF_FREE:
000EB1 4EB1 F5              11      PUSH    AF          ;ドライブ番号を退避
000EB2 4EB2 3A01F3          13      LD  A,(FDRV)
000EB5 4EB5 4F               4      LD  C,A         ;元のFDRVをCへ退避
000EB6 4EB6 F1              10      POP AF
000EB7 4EB7 3C               4      INC A           ;FDRV設定値(ドライブ番号+1、0は既定ドライブの意味)
000EB8 4EB8 3201F3          13      LD  (FDRV),A
000EBB 4EBB C5              11      PUSH    BC          ;元のFDRV(C)を退避
000EBC 4EBC 210000          10      LD  HL,0
       4EBF                     DSKF_FREE1:
000EBF 4EBF 7B               4      LD  A,E         ;DE<2なら終了(有効なクラスタ番号は2以上)
000EC0 4EC0 D602             7      SUB 2
000EC2 4EC2 7A               4      LD  A,D
000EC3 4EC3 DE00             7      SBC A,0
000EC5 4EC5 380F            12      JR  C,DSKF_FREE_END
000EC7 4EC7 D5              11      PUSH    DE
000EC8 4EC8 CD8E4E          17      CALL    GNCL
000ECB 4ECB 3805            12      JR  C,DSKF_FREE2
000ECD 4ECD 7A               4      LD  A,D
000ECE 4ECE B3               4      OR  E
000ECF 4ECF 2001            12      JR  NZ,DSKF_FREE2
