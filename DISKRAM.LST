                                ;
                                ;   空きクラスタ数を数える
                                ;   IN  A =対象ドライブ番号(0オリジン、0=A: 1=B:)
                                ;       DE=MAXCLUS(最後に調べるクラスタ番号、GETDPBの計算結果そのまま)
                                ;   OUT HL=空きクラスタ数
                                ;
                                ;   クラスタ番号は標準的なFAT12の2オリジン(有効なクラスタ番号は
                                ;   2〜MAXCLUS)。GNCL/NCL3もこの前提で作られている為、2未満の
                                ;   クラスタは調べない。
                                ;
                                ;   FDRVの退避・復帰はこのルーチン内で完結する
                                ;   (GNCL/NCL3内部でGET_DISK_BANK_FDRVを使ってFATのバンクを選ぶ為、
                                ;   呼び出し中だけFDRVを対象ドライブに切り替える)
                                ;
       4E99                     DSKF_FREE:
000E99 4E99 F5              11      PUSH    AF          ;ドライブ番号を退避
000E9A 4E9A 3A02F3          13      LD  A,(FDRV)
000E9D 4E9D 4F               4      LD  C,A         ;元のFDRVをCへ退避
000E9E 4E9E F1              10      POP AF
000E9F 4E9F 3C               4      INC A           ;FDRV設定値(ドライブ番号+1、0は既定ドライブの意味)
000EA0 4EA0 3202F3          13      LD  (FDRV),A
000EA3 4EA3 C5              11      PUSH    BC          ;元のFDRV(C)を退避
000EA4 4EA4 210000          10      LD  HL,0
       4EA7                     DSKF_FREE1:
000EA7 4EA7 7B               4      LD  A,E         ;DE<2なら終了(有効なクラスタ番号は2以上)
000EA8 4EA8 D602             7      SUB 2
000EAA 4EAA 7A               4      LD  A,D
000EAB 4EAB DE00             7      SBC A,0
000EAD 4EAD 380F            12      JR  C,DSKF_FREE_END
000EAF 4EAF D5              11      PUSH    DE
000EB0 4EB0 CD764E          17      CALL    GNCL
000EB3 4EB3 3805            12      JR  C,DSKF_FREE2
000EB5 4EB5 7A               4      LD  A,D
000EB6 4EB6 B3               4      OR  E
000EB7 4EB7 2001            12      JR  NZ,DSKF_FREE2
000EB9 4EB9 23               6      INC HL
       4EBA                     DSKF_FREE2:
000EBA 4EBA D1              10      POP DE
000EBB 4EBB 1B               6      DEC DE
000EBC 4EBC 18E9            12      JR  DSKF_FREE1
       4EBE                     DSKF_FREE_END:
000EBE 4EBE C1              10      POP BC          ;元のFDRVを復帰
000EBF 4EBF 79               4      LD  A,C
000EC0 4EC0 3202F3          13      LD  (FDRV),A
000EC3 4EC3 C9              10      RET
                                
       4EC4                     CLUST:
000EC4 4EC4 EB               4      EX  DE,HL
       4EC5                     CLUST_HL:
000EC5 4EC5 2B               6      DEC HL
000EC6 4EC6 2B               6      DEC HL
000EC7 4EC7 C5              11      PUSH    BC
