001BD9 F2A6 F7              12      RST 30H
       F2A7                     ROM_SLT_COPY:
001BDA F2A7 00                      DB  0
001BDB F2A8 4348                    DW  ROM_COPY
001BDD F2AA C9              10      RET
       F2AB                     RAMUSE1:
001BDE F2AB 3A42F3          13      LD  A,(RAMAD1)
001BE1 F2AE 180E            12      JR  _ENASLT_40H
       F2B0                     CAL_MP:
001BE3 F2B0 2640             7      LD  H,040H
001BE5 F2B2 3AC1FC          13      LD  A,(EXPTBL)
001BE8 F2B5 CD2400          17      CALL    _ENASLT
001BEB F2B8 CD1C00          17      CALL    _CALSLT
