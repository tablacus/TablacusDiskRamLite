                                ;=====================================================================
                                ;   2バンク目 (ファイルオフセット 2000H-3FFFH / セグメント#1)
                                ;
                                ;   普段はDISKデータ(セグメント2以降)の読み出しウィンドウとして
                                ;   使われるBANK1(6000h-7fffh)に、必要な時だけ切り替えてマッピング
                                ;   して使う、常駐コード置き場。
                                ;     - 似非RAMディスクへの書き込みルーチン(DISK_WRITE_RAM)
                                ;     - 起動時のみ使うRAM検出ルーチン(CHK_RAM等)
                                ;   など、「頻繁に呼ばれない」「BANK1を他の目的で使っていない
                                ;   タイミングでしか呼ばれない」ルーチンをここに集約している。
                                ;
                                ;   この2バンク目が常に存在する為、DEF.ASMでDISK_BANK=2にして
                                ;   ディスクイメージの先頭(ドライブA)がセグメント2から始まるように
                                ;   している。DISKRAM.BIN本体が8KBから16KBになった分、後ろに連結
                                ;   するDSKファイルの位置がそのままズレるだけなので、連結の手順
                                ;   自体は従来と同じ(単純に連結するだけ)。
                                ;=====================================================================
002000 6000                         ORG 06000H,$$
                                    INCLUDE "BANK1.ASM"
                                ;
                                ;   Tablacus DISK RAM Lite - BANK1(6000h-7fffh)常駐コード置き場
                                ;
                                ;   このファイルは2バンク目(ファイル先頭から2000H-3FFFHの位置/
                                ;   セグメント#1)に配置される。普段はディスクデータ(セグメント2
                                ;   以降)の読み出しウィンドウとして使われるBANK1(6000h-7fffh)に、
                                ;   必要な時だけ切り替えてマッピングして使う。
                                ;
                                ;   現在ここに置いているもの:
                                ;     - DISK_WRITE_RAM: 似非RAMディスクへの書き込みルーチン
                                ;     - CHK_RAM他: 起動時のみ使うRAM検出ルーチン
                                ;
                                ;   バンク選択レジスタBANK0_SELのアドレス(6000H)はBANK1の範囲内にある為、
                                ;   書き込み中に自分自身(常駐している1バンク目のドライバ本体)を
                                ;   バンク切り替えで消してしまわないように、DISK_WRITE_RAMだけを
                                ;   BANK1側に置いて実行する。BANK0(4000h-5fffh)側を切り替えて
                                ;   似非RAMディスクの書き込みウィンドウとして使う。
                                ;
                                ;   呼び出し規約(DISKIO1と同じ):
                                ;     A  = 書き込み先ディスクの起点バンク(GET_DISK_BANKの結果)
                                ;     B  = 残りのセクタ数
                                ;     DE = セクタ番号
                                ;     HL = 転送元メモリアドレス(書き込みたいデータがあるバッファ)
                                ;   戻り値:
                                ;     A  = 0(成功)
                                ;     B  = 呼び出し時のセクタ数
                                ;
                                ;   ※MUL_AHLは1バンク目(BANK0)常駐なので、書き込み中(BANK0が
                                ;     RAMセグメントに切り替わっている間)は直接CALLできない。
                                ;     その為このバンクにも同じ内容のコピーを用意する。
                                ;
       6000                     MUL_AHL_W:
002000 6000 37               4      SCF         ;無限ループ回避
       6001                     MUL_AHL_W1:
002001 6001 1F               4      RRA         ;->CF
002002 6002 D8              11      RET C
002003 6003 29              11      ADD HL,HL
002004 6004 18FB            12      JR  MUL_AHL_W1
                                
       6006                     DISK_WRITE_RAM:
002006 6006 F3               4      DI          ;BANK0切り替え中の割り込みを防止
002007 6007 E5              11      PUSH    HL
       6008                     DISKIO1W:
002008 6008 C5              11      PUSH    BC      ;B=残りのセクタ数
002009 6009 D5              11      PUSH    DE      ;DE=セクタ番号
00200A 600A F5              11      PUSH    AF      ;A=8KB単位でカートリッジ内のディスクが存在する位置を指定
                                
00200B 600B EB               4      EX  DE,HL       ;DE=書き込み元のメモリアドレス HL=セクタ番号
00200C 600C F5              11      PUSH    AF
00200D 600D 3ACBF2          13      LD  A,(SECSZ_H)
002010 6010 CD0060          17      CALL    MUL_AHL_W
002013 6013 F1              10      POP AF
002014 6014 4D               4      LD  C,L     ;C=書き込み元アドレスのセグメント内オフセット(下位)
002015 6015 29              11      ADD HL,HL       ;64KB→32KB
002016 6016 29              11      ADD HL,HL       ;32KB→16KB
002017 6017 29              11      ADD HL,HL       ;16KB→8KB  バンク切り替えのサイズに合わせる
002018 6018 84               4      ADD A,H     ;A=書き込み先の8KBバンク番号
002019 6019 F680             7      OR  080H        ;似非RAMディスクのバンク(80H以降)を指定する
00201B 601B 320060          13      LD  (BANK0_SEL),A           ;ASCII-8K
                                                    ;BANK0(4000h-5fffh)にRAMセグメントを表示させる
00201E 601E 79               4      LD  A,C     ;C=書き込み元アドレスのセグメント内オフセット
00201F 601F E61F             7      AND 01FH        ;セグメントのサイズでフィルタする(8K:1F)
002021 6021 C640             7      ADD A,high BANK0_ADR
002023 6023 67               4      LD  H,A
002024 6024 ED4BCAF2        20      LD  BC,(SECSZ)  ;BCは書き込むセクタサイズ
002028 6028 69               4      LD  L,C     ;L=0
002029 6029 EB               4      EX  DE,HL       ;HL=書き込み元メモリアドレス DE=書き込み先(RAMディスクウィンドウ)
00202A 602A EDB0                    LDIR
00202C 602C F1              10      POP AF
00202D 602D D1              10      POP DE
00202E 602E 13               6      INC DE
00202F 602F C1              10      POP BC
002030 6030 10D6            13      DJNZ    DISKIO1W
002032 6032 41               4      LD  B,C
                                
002033 6033 E1              10      POP HL
002034 6034 AF               4      XOR A       ;バンク0を元(ドライバ本体/セグメント0)に戻す
002035 6035 320060          13      LD  (BANK0_SEL),A           ;ASCII-8K
002038 6038 FB               4      EI
002039 6039 C9              10      RET
                                
                                ;
                                ;   RAM検出ルーチン(起動時の初期化(INIT_300)からのみ呼ばれる)
                                ;   INIT_300側で事前にBANK1(6000h-7fffh)へこのセグメント#1を
                                ;   マッピングしてから呼び出すこと。呼び出し後、INIT_300側で
                                ;   BANK1をディスクA:のデータ領域(DISK_BANK)に戻す必要がある。
                                ;
                                ;   RDSLTX/_WRSLTはBANK0側(セグメント0)常駐なので、ここから
                                ;   CALLしても問題ない(切り替わるのはBANK1側だけの為)。
                                ;
       603A                     CHK_RAM:
00203A 603A E5              11      PUSH    HL
00203B 603B CD9160          17      CALL    CHK_RAM0
00203E 603E E1              10      POP HL
00203F 603F C8              11      RET Z
002040 6040 3AC1FC          13      LD  A,(EXPTBL)      ;スロット#0
002043 6043 E680             7      AND 080H
002045 6045 CD6660          17      CALL    CHK_RAM_SLT
002048 6048 C8              11      RET Z
002049 6049 3AC2FC          13      LD  A,(EXPTBL+1)        ;スロット#1
00204C 604C E680             7      AND 080H
00204E 604E C601             7      ADD A,1
002050 6050 CD6660          17      CALL    CHK_RAM_SLT
002053 6053 C8              11      RET Z
002054 6054 3AC3FC          13      LD  A,(EXPTBL+2)        ;スロット#2
002057 6057 E680             7      AND 080H
002059 6059 C602             7      ADD A,2
00205B 605B CD6660          17      CALL    CHK_RAM_SLT
00205E 605E C8              11      RET Z
00205F 605F 3AC4FC          13      LD  A,(EXPTBL+3)        ;スロット#3
002062 6062 E680             7      AND 080H
002064 6064 C603             7      ADD A,3
       6066                     CHK_RAM_SLT:
002066 6066 E5              11      PUSH    HL
002067 6067 CD9160          17      CALL    CHK_RAM0        ;スロット#X or X-0
00206A 606A E1              10      POP HL
00206B 606B C8              11      RET Z
00206C 606C CB79             8      BIT 7,C
00206E 606E 281C            12      JR  Z,CHK_RAM_E     ;スロットは拡張されていない
002070 6070 79               4      LD  A,C
002071 6071 F604             7      OR  4           ;スロット#X-1
002073 6073 E5              11      PUSH    HL
002074 6074 CD9160          17      CALL    CHK_RAM0
002077 6077 E1              10      POP HL
002078 6078 C8              11      RET Z
002079 6079 79               4      LD  A,C
00207A 607A F60C             7      OR  00CH            ;スロット#X-3
00207C 607C E5              11      PUSH    HL
00207D 607D CD9160          17      CALL    CHK_RAM0
002080 6080 E1              10      POP HL
002081 6081 C8              11      RET Z
002082 6082 79               4      LD  A,C
002083 6083 E6F3             7      AND 0F3H            ;スロット#X-2
002085 6085 F608             7      OR  8
002087 6087 E5              11      PUSH    HL
002088 6088 CD9160          17      CALL    CHK_RAM0
00208B 608B E1              10      POP HL
       608C                     CHK_RAM_E:
00208C 608C AF               4      XOR A
00208D 608D 3C               4      INC A           ;ZF=0にする
00208E 608E 3E00             7      LD  A,0
002090 6090 C9              10      RET
                                
       6091                     CHK_RAM0:
002091 6091 4F               4      LD  C,A
002092 6092 2E00             7      LD  L,0
       6094                     CHK_RAM1:
002094 6094 79               4      LD  A,C
002095 6095 CD4745          17      CALL    RDSLTX
002098 6098 C6E5             7      ADD A,0E5H
00209A 609A 47               4      LD  B,A
00209B 609B 5F               4      LD  E,A
00209C 609C 79               4      LD  A,C
00209D 609D C5              11      PUSH    BC
00209E 609E CD1400          17      CALL    _WRSLT
0020A1 60A1 C1              10      POP BC
0020A2 60A2 79               4      LD  A,C
0020A3 60A3 CD4745          17      CALL    RDSLTX
0020A6 60A6 B8               4      CP  B
0020A7 60A7 C0              11      RET NZ
0020A8 60A8 D6E5             7      SUB 0E5H
0020AA 60AA 79               4      LD  A,C
0020AB 60AB 5F               4      LD  E,A
0020AC 60AC C5              11      PUSH    BC
0020AD 60AD CD1400          17      CALL    _WRSLT
0020B0 60B0 C1              10      POP BC
0020B1 60B1 24               4      INC H
0020B2 60B2 7D               4      LD  A,L
0020B3 60B3 C604             7      ADD A,4
0020B5 60B5 6F               4      LD  L,A
0020B6 60B6 20DC            12      JR  NZ,CHK_RAM1
0020B8 60B8 79               4      LD  A,C     ;ZF=1のハズ
0020B9 60B9 C9              10      RET
                                
                                ;
                                ;   似非RAMディスクの任意の位置のバイト列を書き換える
                                ;   (ファイル名変更(_SYS17)等、ディレクトリエントリの一部だけを
                                ;    書き換えたい場合に使用する。DISK_WRITE_RAMのようなセクタ単位
                                ;    の計算は行わず、呼び出し元が指定したアドレスへそのまま書き込む)
                                ;
                                ;   IN  A  = 書き換え先データが現在マッピングされているセグメント番号
                                ;             (GET_DISK_BANK_FDRV/_DIR_BANK等で得られる値)
                                ;       HL = 書き換え先アドレス(BANK1_ADR相対、6000h-7fffhの範囲)
                                ;       DE = 書き込むデータの転送元メモリアドレス
                                ;       B  = 書き込むバイト数
                                ;   OUT A  = 0(成功)
                                ;
       60BA                     PATCH_RAM_BYTES:
0020BA 60BA F3               4      DI          ;BANK0切り替え中の割り込みを防止
0020BB 60BB F5              11      PUSH    AF      ;A=セグメント番号を退避(BCはLDIRのバイト数として
                                                ;呼び出し元から渡されている為、Cを潰さないようにする)
0020BC 60BC 7C               4      LD  A,H
0020BD 60BD E61F             7      AND 01FH        ;セグメントのサイズでフィルタする(8K:1F)
0020BF 60BF C640             7      ADD A,high BANK0_ADR
0020C1 60C1 67               4      LD  H,A     ;HL=書き換え先アドレス(BANK0_ADR相対)に変換
0020C2 60C2 F1              10      POP AF      ;A=セグメント番号を復帰
0020C3 60C3 F680             7      OR  080H        ;似非RAMディスクのセグメント(80H以降)を指定する
0020C5 60C5 320060          13      LD  (BANK0_SEL),A       ;ASCII-8K
                                                    ;BANK0(4000h-5fffh)にRAMセグメントを表示させる
0020C8 60C8 EB               4      EX  DE,HL       ;HL=書き込み元メモリアドレス DE=書き込み先(RAMディスクウィンドウ)
0020C9 60C9 EDB0                    LDIR
0020CB 60CB AF               4      XOR A       ;バンク0を元(ドライバ本体/セグメント0)に戻す
0020CC 60CC 320060          13      LD  (BANK0_SEL),A       ;ASCII-8K
0020CF 60CF FB               4      EI
0020D0 60D0 C9              10      RET
[EOF:BANK1.ASM:UTF_8]
       20D1                     LAST2   EQU $$
0020D1 60D1                         DS  03FFFH-LAST2
003FFF 7FFF 00                      DB  0
                                
                                    END
