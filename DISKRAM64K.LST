000FB7 4FB7 84               4      ADD A,H
000FB8 4FB8 320068          13      LD  (BANK1_SEL),A           ;ASCII-8K
000FBB 4FBB 32C4F2          13      LD  (_BANK),A
000FBE 4FBE 69               4      LD  L,C     ;C=読み出し元
000FBF 4FBF 3E1F             7      LD  A,01FH          ;セグメントのサイズでフィルタする(8K:1F)
000FC1 4FC1 A5               4      AND L
                                #endif
