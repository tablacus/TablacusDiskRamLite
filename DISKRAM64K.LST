                                ;
                                ;   空きクラスタ数を数える
                                ;   IN  A =対象ドライブ番号(0オリジン、0=A: 1=B:)
                                ;       DE=MAXCLUS(最後に調べるクラスタ番号、GETDPBの計算結果そのまま)
                                ;   OUT HL=空きクラスタ数
                                ;
                                ;   クラスタ番号は標準的なFAT12の2オリジン(有効なクラスタ番号は
                                ;   2〜MAXCLUS)。GNCL/NCL3もこの前提で作られている為、2未満の
                                ;   クラスタは調べない。
                                ;
                                ;   FDRVの退避・復帰はこのルーチン内で完結する
                                ;   (GNCL/NCL3内部でGET_DISK_BANK_FDRVを使ってFATのバンクを選ぶ為、
                                ;   呼び出し中だけFDRVを対象ドライブに切り替える)
                                ;
       4F7B                     DSKF_FREE:
000F7B 4F7B F5              11      PUSH    AF          ;ドライブ番号を退避
000F7C 4F7C 3A02F3          13      LD  A,(FDRV)
000F7F 4F7F 4F               4      LD  C,A         ;元のFDRVをCへ退避
000F80 4F80 F1              10      POP AF
000F81 4F81 3C               4      INC A           ;FDRV設定値(ドライブ番号+1、0は既定ドライブの意味)
000F82 4F82 3202F3          13      LD  (FDRV),A
000F85 4F85 C5              11      PUSH    BC          ;元のFDRV(C)を退避
000F86 4F86 210000          10      LD  HL,0
       4F89                     DSKF_FREE1:
000F89 4F89 7B               4      LD  A,E         ;DE<2なら終了(有効なクラスタ番号は2以上)
000F8A 4F8A D602             7      SUB 2
000F8C 4F8C 7A               4      LD  A,D
000F8D 4F8D DE00             7      SBC A,0
000F8F 4F8F 380F            12      JR  C,DSKF_FREE_END
000F91 4F91 D5              11      PUSH    DE
000F92 4F92 CD584F          17      CALL    GNCL
000F95 4F95 3805            12      JR  C,DSKF_FREE2
000F97 4F97 7A               4      LD  A,D
000F98 4F98 B3               4      OR  E
000F99 4F99 2001            12      JR  NZ,DSKF_FREE2
000F9B 4F9B 23               6      INC HL
       4F9C                     DSKF_FREE2:
000F9C 4F9C D1              10      POP DE
