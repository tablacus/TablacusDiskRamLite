                                ;
                                ;   空きクラスタ数を数える
                                ;   IN  A =対象ドライブ番号(0オリジン、0=A: 1=B:)
                                ;       DE=MAXCLUS(最後に調べるクラスタ番号、GETDPBの計算結果そのまま)
                                ;   OUT HL=空きクラスタ数
                                ;
                                ;   クラスタ番号は標準的なFAT12の2オリジン(有効なクラスタ番号は
                                ;   2〜MAXCLUS)。GNCL/NCL3もこの前提で作られている為、2未満の
                                ;   クラスタは調べない。
                                ;
                                ;   FDRVの退避・復帰はこのルーチン内で完結する
                                ;   (GNCL/NCL3内部でGET_DISK_BANK_FDRVを使ってFATのバンクを選ぶ為、
                                ;   呼び出し中だけFDRVを対象ドライブに切り替える)
                                ;
       4F63                     DSKF_FREE:
000F63 4F63 F5              11      PUSH    AF          ;ドライブ番号を退避
000F64 4F64 3A02F3          13      LD  A,(FDRV)
000F67 4F67 4F               4      LD  C,A         ;元のFDRVをCへ退避
000F68 4F68 F1              10      POP AF
000F69 4F69 3C               4      INC A           ;FDRV設定値(ドライブ番号+1、0は既定ドライブの意味)
000F6A 4F6A 3202F3          13      LD  (FDRV),A
000F6D 4F6D C5              11      PUSH    BC          ;元のFDRV(C)を退避
000F6E 4F6E 210000          10      LD  HL,0
       4F71                     DSKF_FREE1:
000F71 4F71 7B               4      LD  A,E         ;DE<2なら終了(有効なクラスタ番号は2以上)
000F72 4F72 D602             7      SUB 2
000F74 4F74 7A               4      LD  A,D
000F75 4F75 DE00             7      SBC A,0
000F77 4F77 380F            12      JR  C,DSKF_FREE_END
000F79 4F79 D5              11      PUSH    DE
000F7A 4F7A CD404F          17      CALL    GNCL
000F7D 4F7D 3805            12      JR  C,DSKF_FREE2
000F7F 4F7F 7A               4      LD  A,D
000F80 4F80 B3               4      OR  E
000F81 4F81 2001            12      JR  NZ,DSKF_FREE2
000F83 4F83 23               6      INC HL
       4F84                     DSKF_FREE2:
000F84 4F84 D1              10      POP DE
000F85 4F85 1B               6      DEC DE
000F86 4F86 18E9            12      JR  DSKF_FREE1
       4F88                     DSKF_FREE_END:
000F88 4F88 C1              10      POP BC          ;元のFDRVを復帰
000F89 4F89 79               4      LD  A,C
000F8A 4F8A 3202F3          13      LD  (FDRV),A
000F8D 4F8D C9              10      RET
                                
       4F8E                     CLUST:
000F8E 4F8E EB               4      EX  DE,HL
       4F8F                     CLUST_HL:
000F8F 4F8F 2B               6      DEC HL
000F90 4F90 2B               6      DEC HL
000F91 4F91 C5              11      PUSH    BC
